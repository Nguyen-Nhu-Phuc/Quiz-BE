PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/quizpractice
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
# Key dự phòng (cách nhau bởi dấu phẩy). Hết quota key 1 → tự dùng key tiếp theo.
# GEMINI_API_KEYS=key_du_phong_1,key_du_phong_2
# Hoặc: GEMINI_API_KEY_2=...  /  GEMINI_API_KEY_3=...
GEMINI_MODEL=gemini-2.0-flash
CLIENT_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=40
